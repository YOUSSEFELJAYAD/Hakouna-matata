    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/compression": "^1.7.5",
    "typescript": "^5.6.3",
    "tsx": "^4.7.0",
    "eslint": "^9.13.0",
